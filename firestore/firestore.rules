rules_version = '2';

// Clients never talk to Firestore directly. All access goes through the backend,
// which uses the Admin SDK (rules do not apply to it) and enforces membership
// against PostgreSQL before every read or write. Deny everything else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
