# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (docker compose exposes the dev database on localhost:5432)
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat
DATABASE_POOL_MAX=10

# Firebase / Firestore
FIREBASE_PROJECT_ID=demo-chat-backend
# Local: point at the emulator (no credentials needed). Remove in production.
FIRESTORE_EMULATOR_HOST=localhost:8080
# Production: either rely on Application Default Credentials (recommended on GCP),
# or provide a base64-encoded service-account JSON via your secret manager:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=nodejs-chat-backend
JWT_AUDIENCE=nodejs-chat-backend-api
REFRESH_TOKEN_TTL_DAYS=30

# HTTP
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENABLE_API_DOCS=true

# Rate limiting (per instance)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Optional: password for `pnpm db:seed` demo users
# SEED_USER_PASSWORD=
